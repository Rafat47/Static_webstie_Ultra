# ==============================================================================
# Hair Shurokkha Storefront — Environment Configuration Template
# ==============================================================================
# In Netlify Site Configuration > Environment variables, configure these scopes:

# 1. Storefront Build-Time URI (Scope: Builds only)
# Read-only database user restricted strictly to collection: hair_shurokkha.site_ui
MONGODB_URI_BUILD=mongodb+srv://storefront_build_ro:<password>@cluster0.abcde.mongodb.net/hair_shurokkha?retryWrites=true&w=majority

# 2. Storefront Serverless Functions URI (Scope: Functions only)
# Third DB user: readWrite on orders & event_logs; read on secrets & site_ui
MONGODB_URI_FN=mongodb+srv://storefront_fn:<password>@cluster0.abcde.mongodb.net/hair_shurokkha?retryWrites=true&w=majority

# 3. Database Name (Scope: Builds, Functions)
MONGODB_DB=hair_shurokkha

# 4. Meta Conversions API Access Token (Scope: Functions only)
META_CAPI_TOKEN=EAAB...your_system_user_token...

# 5. Meta Pixel ID fallback (Scope: Builds) — Note: Primary ID is loaded from site_ui in MongoDB
META_PIXEL_ID=17225166561875251
VITE_META_PIXEL_ID=17225166561875251
SITE_URL=https://hairshurokkha.com
