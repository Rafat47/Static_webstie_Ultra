# ==========================================
# MINOXIDIL WEBSITE - ENVIRONMENT CONFIG
# ==========================================

# 1. MongoDB Database Connection
# Replace with your MongoDB Atlas Free tier URI:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/haircare_store?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://demo:demo@cluster0.example.mongodb.net/haircare_store?retryWrites=true&w=majority

# 2. Admin Authentication
JWT_SECRET=super_secret_haircare_jwt_key_min_32_characters_long_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@HairCare2026

# 3. Cloudinary (Optional - Direct image URL input and fallbacks available)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. Meta Facebook Pixel & Conversions API (CAPI)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# 5. Application URLs & Environment
SITE_URL=http://localhost:3000
NODE_ENV=development
PORT=5000

